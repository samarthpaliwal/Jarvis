# Jarvis settings overrides.
#
# Jarvis is a menu-bar app, so it has no shell environment. Copy this file to
#   ~/Library/Application Support/Jarvis/jarvis.env
# and uncomment what you want to change. Restart Jarvis afterwards. A variable set in the real
# process environment wins over this file. Everything here can also be set in profile.json → tuning.
#
# NO SECRETS HERE. API keys live in the macOS Keychain (Jarvis menu → Set API Key…).
# Jarvis ignores any variable in this file whose name contains KEY, TOKEN, SECRET, PASSWORD or CREDENTIAL.
# For development only, ANTHROPIC_API_KEY in the real process environment overrides the Keychain.

# --- Models -------------------------------------------------------------------------------------
# CLAUDE_MODEL=claude-sonnet-5-5
# JARVIS_LLM_EFFORT=low                      # low | medium | high | xhigh | max
# JARVIS_ANTHROPIC_VERSION=2026-10-21
# JARVIS_OPENAI_TTS_MODEL=gpt-4o-mini-tts

# --- Wake word ----------------------------------------------------------------------------------
# JARVIS_WAKE_THRESHOLD=0.5                  # 0…1; lower wakes more easily (and more falsely)
# JARVIS_WAKE_COOLDOWN_SECONDS=2

# --- Microphone recovery ------------------------------------------------------------------------
# JARVIS_MIC_SILENCE_TIMEOUT_SECONDS=6
# JARVIS_MIC_RESTART_DEBOUNCE_SECONDS=0.5
# JARVIS_MIC_MAX_BACKOFF_SECONDS=60
# JARVIS_MIC_DEAF_AFTER_REBUILDS=3

# --- Language model limits ----------------------------------------------------------------------
# JARVIS_LLM_MAX_HISTORY_MESSAGES=24
# JARVIS_LLM_MAX_TOOL_ROUNDS=10
# JARVIS_LLM_HISTORY_TIMEOUT_MINUTES=10
# JARVIS_LLM_REQUEST_TIMEOUT_SECONDS=60
# JARVIS_LLM_RESOURCE_TIMEOUT_SECONDS=300

# --- Spending ------------------------------------------------------------------------------------
# JARVIS_DAILY_BUDGET_USD=3                  # paid requests stop for the day at this; 0 = no cap
# JARVIS_BUDGET_WARN_FRACTION=0.8            # Jarvis says so once at this share of the budget
# JARVIS_MODEL_REQUESTS_PER_MINUTE=30        # more than this is treated as a runaway loop
# JARVIS_SPEECH_REQUESTS_PER_MINUTE=90       # paid voices only (ElevenLabs, OpenAI)

# --- Network: timeouts and retries --------------------------------------------------------------
# JARVIS_HTTP_TIMEOUT_SECONDS=15             # Gmail, Notion, Spotify, Google sign-in
# JARVIS_HTTP_MAX_RETRIES=2                  # after a busy server or dropped connection; applies to Claude too
# JARVIS_HTTP_RETRY_BASE_SECONDS=0.5         # first wait; doubles each attempt
# JARVIS_HTTP_RETRY_MAX_SECONDS=8            # longest single wait, even if the server asks for more

# --- Tools --------------------------------------------------------------------------------------
# JARVIS_TOOL_CALL_BUDGET_PER_TURN=16
# JARVIS_LOCAL_TOOL_CALL_BUDGET_PER_TURN=6
# JARVIS_WEB_FETCH_MAX_CONTENT_TOKENS=8000
# JARVIS_APPROVAL_TIMEOUT_SECONDS=12
# JARVIS_TOOL_TIMEOUT_SECONDS=45             # one tool call; then Jarvis says it timed out
# JARVIS_TURN_TIMEOUT_SECONDS=120            # one whole request
# JARVIS_REPEAT_ERROR_AFTER_SECONDS=60       # the same spoken error is not repeated sooner than this

# --- Speech out ---------------------------------------------------------------------------------
# JARVIS_KOKORO_PORT=8880
# JARVIS_TTS_REQUEST_TIMEOUT_SECONDS=15

# --- Latency ------------------------------------------------------------------------------------
# JARVIS_ENDPOINT_FAST_SILENCE_SECONDS=0.9   # silence that ends a turn once the sentence is complete; 0 = off
# JARVIS_ENDPOINT_FAST_MIN_WORDS=3
# JARVIS_TTS_FIRST_CHUNK_MIN_WORDS=3         # speak the opening clause early; 0 = wait for the sentence
# JARVIS_CACHE_PREWARM_AFTER_SECONDS=240     # warm Claude's cache when a request starts after this idle time; 0 = off

# --- Short-term memory ---------------------------------------------------------------------------
# JARVIS_SESSION_MEMORY_MINUTES=30           # a new chat is told about chats this recent (RAM only); 0 = off
# JARVIS_SESSION_MEMORY_EXCHANGES=6

# --- Voice ID -----------------------------------------------------------------------------------
# JARVIS_SPEAKER_THRESHOLD=0.5               # how alike a voice must be to yours (0…1); higher is stricter
# JARVIS_UNVERIFIED_VOICE_APPROVAL=button    # button (approve on screen instead) | never (refuse)

# --- Remote access (the API itself is switched on in the menu: Remote Access) -------------------
# JARVIS_REMOTE_PORT=8787
# JARVIS_REMOTE_BIND=tailscale               # tailscale | loopback (127.0.0.1). Never every address.
# JARVIS_REMOTE_MAX_AUDIO_SECONDS=60         # longest recording in one remote request
# JARVIS_REMOTE_APPROVAL_TIMEOUT_SECONDS=60  # an unanswered remote approval counts as "no"
# JARVIS_REMOTE_ALLOWED_ORIGINS=            # extra web origins for a native wrapper, e.g. capacitor://localhost (empty: none)

# --- Stability ----------------------------------------------------------------------------------
# JARVIS_HANG_TIMEOUT_SECONDS=30             # a frozen main thread for this long restarts Jarvis; 0 = off

# --- Camera -------------------------------------------------------------------------------------
# JARVIS_VIDEO_MAX_SECONDS=300               # the longest video Jarvis records in one go

# --- Echo (Jarvis hearing its own voice) --------------------------------------------------------
# JARVIS_SPEECH_BARGE_IN=headphones          # headphones | always | never ("stop" and the wake word always work)
# JARVIS_FOLLOW_UP_GUARD_MILLISECONDS=350    # quiet gap before listening for a follow-up
# JARVIS_ECHO_WINDOW_SECONDS=20

# --- Logs ---------------------------------------------------------------------------------------
# JARVIS_LOG_MAX_MEGABYTES=5                 # rotate a log file past this size
# JARVIS_LOG_KEEP_FILES=3                    # rotated files kept per log

# --- Privacy and retention (days; 0 = keep forever) ---------------------------------------------
# JARVIS_CLOUD_SPEECH_RECOGNITION=never      # never | allow (send request audio to Apple if this Mac cannot recognize on-device)
# JARVIS_RETAIN_CONVERSATIONS_DAYS=30        # what was said (conversations.log)
# JARVIS_RETAIN_TRACE_DAYS=30                # timings, no words (trace.jsonl)
# JARVIS_RETAIN_LOG_DAYS=14                  # diagnostics (jarvis.log)
# JARVIS_RETAIN_ACTIONS_DAYS=90              # every tool call (actions.log)
# JARVIS_RETAIN_MEDIA_DAYS=0                 # photos and videos Jarvis took; older ones go to the Trash

# --- Paths and debugging ------------------------------------------------------------------------
# JARVIS_CONFIG_DIR=~/Library/Application Support/Jarvis/config
# JARVIS_NO_WAKE=1                           # skip the microphone entirely
# JARVIS_WAKE_DEBUG=1                        # log every wake score ≥ 0.1
# JARVIS_FORCE_SFSPEECH=1                    # use the older Apple recognizer
